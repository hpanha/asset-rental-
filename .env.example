# PostgreSQL Connection String
# On Vercel (Neon / Vercel Postgres), DATABASE_URL is injected automatically when you link the database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# JWT Session Signing Secret (required in production — generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-strong-random-secret"

